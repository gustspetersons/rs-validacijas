model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: lv-LV
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["DataFolder","E-taloni","Lietotnes","Maršruti","Datumi","Stundas","Piekļuves tiesības"]

ref table E-taloni
ref table Lietotnes
ref table Maršruti
ref table Datumi
ref table Stundas
ref table Mēri
ref table 'Piekļuves tiesības'

ref role 'Piekļuve pēc lietotāja'

ref cultureInfo en-US

